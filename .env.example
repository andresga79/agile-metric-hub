# =============================================
# Agile Metrics Dashboard — Environment Config
# =============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# All variables have safe defaults for local docker compose up.
# Only set values you want to override.

# --- Jira Configuration ---
# Your Jira Cloud instance URL (e.g. https://your-company.atlassian.net)
# Leave blank to use built-in mock data (4 sample projects with realistic metrics)
JIRA_URL=https://your-company.atlassian.net

# The email address of the Jira account to use for API access
JIRA_EMAIL=your-email@company.com

# Jira API token — generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# --- Database Configuration ---
POSTGRES_USER=agile_user
POSTGRES_PASSWORD=agile_password
POSTGRES_DB=agile_metrics

# Full connection string (auto-built in docker-compose, override if using external DB)
# DATABASE_URL=postgresql://agile_user:agile_password@db:5432/agile_metrics

# --- Authentication ---
# Secret key used to sign JWT tokens. REQUIRED — there is no fallback. In
# production (NODE_ENV=production) the server refuses to start unless this is set,
# >=16 chars, and not a placeholder. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret-key-at-least-32-chars

# JWT token expiry (e.g. "24h", "60m"). Read as JWT_EXPIRE by the code.
JWT_EXPIRE=24h

# --- Default Admin User ---
# Password for the admin account auto-created on first startup (username: admin).
# In production this MUST be set to a strong value (>=8 chars, not "admin123") or
# the server will refuse to bootstrap the admin.
DEFAULT_ADMIN_PASSWORD=change-me-on-first-login

# --- CORS (only needed when frontend and API are on different origins) ---
# Comma-separated allowed origin(s), e.g. your Vercel domain. Left unset = open
# (local dev only). Set on a real deploy: https://agile-metric-hub.vercel.app
# CORS_ORIGIN=https://agile-metric-hub.vercel.app

# NODE_ENV — set to "production" on the deployed backend to enable the strict
# secret checks above. Leave unset locally.
# NODE_ENV=production

# --- Application Settings ---
# Log level: debug | info | warn | error
LOG_LEVEL=info
